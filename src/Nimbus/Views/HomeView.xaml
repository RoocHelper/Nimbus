<UserControl x:Class="Nimbus.Views.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style x:Key="OrbButton" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid x:Name="root" Width="132" Height="132" Background="Transparent" RenderTransformOrigin="0.5,0.5">
                            <Grid.RenderTransform>
                                <ScaleTransform />
                            </Grid.RenderTransform>
                            <Ellipse x:Name="halo" Fill="{StaticResource AccentSubtleBrush}" Opacity="0.55" />
                            <Ellipse Margin="10" Stroke="{StaticResource AccentBrush}" StrokeThickness="3" Fill="#1A2DD4BF" />
                            <Ellipse Margin="4" Stroke="{StaticResource AccentHoverBrush}" StrokeThickness="1.5"
                                     StrokeDashArray="2 6" Opacity="0.6" RenderTransformOrigin="0.5,0.5">
                                <Ellipse.RenderTransform>
                                    <RotateTransform />
                                </Ellipse.RenderTransform>
                                <Ellipse.Triggers>
                                    <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                                        <BeginStoryboard>
                                            <Storyboard RepeatBehavior="Forever">
                                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                                                                 From="0" To="360" Duration="0:0:24" />
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </EventTrigger>
                                </Ellipse.Triggers>
                            </Ellipse>
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE945;" FontSize="26" Foreground="{StaticResource AccentBrush}" />
                                <ContentPresenter Margin="0,8,0,0" HorizontalAlignment="Center"
                                                  TextElement.FontSize="14" TextElement.FontWeight="SemiBold"
                                                  TextElement.Foreground="{StaticResource TextPrimaryBrush}" />
                            </StackPanel>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="root" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1.04" Duration="0:0:0.18" />
                                            <DoubleAnimation Storyboard.TargetName="root" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1.04" Duration="0:0:0.18" />
                                            <DoubleAnimation Storyboard.TargetName="halo" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.18" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="root" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1" Duration="0:0:0.18" />
                                            <DoubleAnimation Storyboard.TargetName="root" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1" Duration="0:0:0.18" />
                                            <DoubleAnimation Storyboard.TargetName="halo" Storyboard.TargetProperty="Opacity" To="0.55" Duration="0:0:0.18" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ActionCard" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="Background" Value="{StaticResource CardBrush}" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{StaticResource CardBorderBrush}"
                                BorderThickness="1" CornerRadius="12" Padding="16">
                            <ContentPresenter HorizontalAlignment="Stretch" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource CardHoverBrush}" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.5" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="StatIcon" TargetType="Border">
            <Setter Property="Width" Value="34" />
            <Setter Property="Height" Value="34" />
            <Setter Property="CornerRadius" Value="17" />
            <Setter Property="Background" Value="{StaticResource AccentSubtleBrush}" />
            <Setter Property="HorizontalAlignment" Value="Left" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="0,4,8,28">
            <TextBlock Text="{Binding GreetingText}" Style="{StaticResource Caption}" FontSize="13.5" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" />
            <TextBlock Text="{DynamicResource S.Nav.Home}" Style="{StaticResource PageTitle}" Margin="0,0,0,16" />

            <!-- Hero -->
            <Border Style="{StaticResource Card}" Padding="22,20">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Button Style="{StaticResource OrbButton}" Content="{DynamicResource S.Home.Optimize}"
                            Command="{Binding OptimizeCommand}" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1" Margin="28,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="{DynamicResource S.Home.HeroTitle}" Style="{StaticResource H2}" FontSize="21" />
                        <TextBlock Text="{Binding PresetDescription}" Style="{StaticResource Body}" Margin="0,6,0,0" MaxWidth="560" HorizontalAlignment="Left" />
                        <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                            <RadioButton Style="{StaticResource Chip}" GroupName="homePreset" Content="{DynamicResource S.Preset.Minimal}"
                                         IsChecked="{Binding SelectedPreset, Converter={StaticResource Eq}, ConverterParameter=Minimal}" />
                            <RadioButton Style="{StaticResource Chip}" GroupName="homePreset" Content="{DynamicResource S.Preset.Standard}"
                                         IsChecked="{Binding SelectedPreset, Converter={StaticResource Eq}, ConverterParameter=Standard}" />
                            <RadioButton Style="{StaticResource Chip}" GroupName="homePreset" Content="{DynamicResource S.Preset.Advanced}"
                                         IsChecked="{Binding SelectedPreset, Converter={StaticResource Eq}, ConverterParameter=Advanced}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xEA18;" FontSize="13" Foreground="{StaticResource SuccessBrush}" />
                            <TextBlock Text="{DynamicResource S.Home.SafetyNote}" Style="{StaticResource Caption}" Margin="8,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Stats -->
            <UniformGrid Columns="4" Margin="-6,12,-6,0">
                <Border Style="{StaticResource Card}" Margin="6">
                    <StackPanel>
                        <Border Style="{StaticResource StatIcon}">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE9E9;" Foreground="{StaticResource AccentBrush}" />
                        </Border>
                        <TextBlock Text="{DynamicResource S.Home.ActiveTweaks}" Style="{StaticResource Caption}" Margin="0,12,0,2" />
                        <TextBlock Text="{Binding ActiveTweaksText}" FontFamily="{StaticResource DisplayFont}" FontSize="22" FontWeight="SemiBold" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="6">
                    <StackPanel>
                        <Border Style="{StaticResource StatIcon}">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE895;" Foreground="{StaticResource AccentBrush}" />
                        </Border>
                        <TextBlock Text="{DynamicResource S.Home.UpdateMode}" Style="{StaticResource Caption}" Margin="0,12,0,2" />
                        <TextBlock Text="{Binding UpdateModeText}" FontSize="16" FontWeight="SemiBold" Margin="0,4,0,0" TextTrimming="CharacterEllipsis">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{StaticResource SuccessBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsUpdatesDisabled}" Value="True">
                                            <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="6">
                    <StackPanel>
                        <Border Style="{StaticResource StatIcon}">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE7F4;" Foreground="{StaticResource AccentBrush}" />
                        </Border>
                        <TextBlock Text="{DynamicResource S.Home.System}" Style="{StaticResource Caption}" Margin="0,12,0,2" />
                        <TextBlock Text="{Binding SystemText}" FontSize="14" FontWeight="SemiBold" Margin="0,4,0,0" TextTrimming="CharacterEllipsis"
                                   ToolTip="{Binding SystemText}" />
                        <TextBlock Text="{Binding SystemDetail}" Style="{StaticResource Caption}" Margin="0,2,0,0" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="6">
                    <StackPanel>
                        <Border Style="{StaticResource StatIcon}" Background="{StaticResource SuccessSubtleBrush}">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xEA18;" Foreground="{StaticResource SuccessBrush}" />
                        </Border>
                        <TextBlock Text="{DynamicResource S.Home.Access}" Style="{StaticResource Caption}" Margin="0,12,0,2" />
                        <TextBlock Text="{DynamicResource S.Home.Admin}" FontSize="15" FontWeight="SemiBold" Margin="0,4,0,0" Foreground="{StaticResource SuccessBrush}" />
                    </StackPanel>
                </Border>
            </UniformGrid>

            <!-- Home edition note -->
            <Border Margin="0,12,0,0" Padding="14,12" CornerRadius="10" Background="{StaticResource WarningSubtleBrush}"
                    Visibility="{Binding IsHomeEdition, Converter={StaticResource BoolVis}}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource Icon}" Text="&#xE946;" FontSize="15" Foreground="{StaticResource WarningBrush}" VerticalAlignment="Top" />
                    <TextBlock Text="{DynamicResource S.Home.HomeEdition}" Margin="10,0,0,0" FontSize="12.5" TextWrapping="Wrap"
                               Foreground="{StaticResource WarningBrush}" MaxWidth="820" />
                </StackPanel>
            </Border>

            <!-- Quick actions -->
            <TextBlock Text="{DynamicResource S.Home.QuickActions}" Style="{StaticResource H2}" Margin="0,22,0,10" />
            <UniformGrid Columns="3" Margin="-6,0">
                <Button Style="{StaticResource ActionCard}" Margin="6"
                        Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="tweaks">
                    <Grid>
                        <StackPanel>
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE9E9;" FontSize="20" HorizontalAlignment="Left" Foreground="{StaticResource AccentBrush}" />
                            <TextBlock Text="{DynamicResource S.Home.ActTweaks}" Style="{StaticResource H3}" Margin="0,12,0,2" />
                            <TextBlock Text="{DynamicResource S.Home.ActTweaksDesc}" Style="{StaticResource Caption}" />
                        </StackPanel>
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE76C;" FontSize="12" HorizontalAlignment="Right" VerticalAlignment="Top" Foreground="{StaticResource TextMutedBrush}" />
                    </Grid>
                </Button>
                <Button Style="{StaticResource ActionCard}" Margin="6"
                        Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="updates">
                    <Grid>
                        <StackPanel>
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE895;" FontSize="20" HorizontalAlignment="Left" Foreground="{StaticResource AccentBrush}" />
                            <TextBlock Text="{DynamicResource S.Home.ActUpdates}" Style="{StaticResource H3}" Margin="0,12,0,2" />
                            <TextBlock Text="{DynamicResource S.Home.ActUpdatesDesc}" Style="{StaticResource Caption}" />
                        </StackPanel>
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE76C;" FontSize="12" HorizontalAlignment="Right" VerticalAlignment="Top" Foreground="{StaticResource TextMutedBrush}" />
                    </Grid>
                </Button>
                <Button Style="{StaticResource ActionCard}" Margin="6" Command="{Binding RestorePointCommand}">
                    <Grid>
                        <StackPanel>
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE777;" FontSize="20" HorizontalAlignment="Left" Foreground="{StaticResource AccentBrush}" />
                            <TextBlock Text="{DynamicResource S.Home.ActRestore}" Style="{StaticResource H3}" Margin="0,12,0,2" />
                            <TextBlock Text="{DynamicResource S.Home.ActRestoreDesc}" Style="{StaticResource Caption}" />
                        </StackPanel>
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE76C;" FontSize="12" HorizontalAlignment="Right" VerticalAlignment="Top" Foreground="{StaticResource TextMutedBrush}" />
                    </Grid>
                </Button>
            </UniformGrid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
