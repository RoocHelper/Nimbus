<UserControl x:Class="Nimbus.Views.HistoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <DockPanel Margin="0,4,8,16">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Bottom">
                <Button Style="{StaticResource GhostButton}" Command="{Binding OpenLogFolderCommand}" Margin="0,0,8,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE838;" FontSize="13" />
                        <TextBlock Text="{DynamicResource S.Hist.OpenLogs}" Margin="8,0,0,0" />
                    </StackPanel>
                </Button>
                <Button Content="{DynamicResource S.Hist.Clear}" Command="{Binding ClearCommand}" />
            </StackPanel>
            <StackPanel>
                <TextBlock Text="{DynamicResource S.Nav.History}" Style="{StaticResource PageTitle}" />
                <TextBlock Text="{DynamicResource S.Hist.Subtitle}" Style="{StaticResource Body}" Margin="0,4,0,0" />
            </StackPanel>
        </DockPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <ItemsControl ItemsSource="{Binding Items}" Margin="0,0,8,20">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource HoverCard}" Margin="0,0,0,8" Padding="16,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Border Width="34" Height="34" CornerRadius="17" VerticalAlignment="Top">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="{StaticResource SuccessSubtleBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Success}" Value="False">
                                                    <Setter Property="Background" Value="{StaticResource DangerSubtleBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <Grid>
                                        <TextBlock Style="{StaticResource Icon}" Text="&#xE73E;" FontSize="14" Foreground="{StaticResource SuccessBrush}"
                                                   Visibility="{Binding Success, Converter={StaticResource BoolVis}}" />
                                        <TextBlock Style="{StaticResource Icon}" Text="&#xE711;" FontSize="13" Foreground="{StaticResource DangerBrush}"
                                                   Visibility="{Binding Success, Converter={StaticResource BoolVis}, ConverterParameter=Invert}" />
                                    </Grid>
                                </Border>
                                <StackPanel Grid.Column="1" Margin="14,0,14,0">
                                    <TextBlock Text="{Binding Title}" Style="{StaticResource H3}" FontSize="13.5" />
                                    <TextBlock Text="{Binding TimeText}" Style="{StaticResource Caption}" Margin="0,2,0,0" />
                                    <TextBlock Text="{Binding ItemsText}" Style="{StaticResource Body}" FontSize="12.5" Margin="0,6,0,0"
                                               Visibility="{Binding ItemsText, Converter={StaticResource NullVis}}" />
                                </StackPanel>
                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Style="{StaticResource GhostButton}" Content="{DynamicResource S.Hist.Log}"
                                            Command="{Binding DataContext.OpenLogCommand, ElementName=Root}" CommandParameter="{Binding}"
                                            Visibility="{Binding HasLog, Converter={StaticResource BoolVis}}" Margin="0,0,6,0" />
                                    <Button Content="{DynamicResource S.Hist.UndoAgain}"
                                            Command="{Binding DataContext.UndoCommand, ElementName=Root}" CommandParameter="{Binding}"
                                            Visibility="{Binding CanUndo, Converter={StaticResource BoolVis}}" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center"
                    Visibility="{Binding IsEmpty, Converter={StaticResource BoolVis}}">
            <Border Width="64" Height="64" CornerRadius="32" Background="{StaticResource AccentSubtleBrush}" HorizontalAlignment="Center">
                <TextBlock Style="{StaticResource Icon}" Text="&#xE81C;" FontSize="26" Foreground="{StaticResource AccentBrush}" />
            </Border>
            <TextBlock Text="{DynamicResource S.Hist.EmptyTitle}" Style="{StaticResource H3}" HorizontalAlignment="Center" Margin="0,14,0,4" />
            <TextBlock Text="{DynamicResource S.Hist.Empty}" Style="{StaticResource Body}" HorizontalAlignment="Center" TextAlignment="Center" MaxWidth="380" />
        </StackPanel>
    </Grid>
</UserControl>
